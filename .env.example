# Web Search API Configuration
# Opțiuni: "serpapi", "brave_search", "bing"
SEARCH_ENGINE=brave_search
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here
SERPAPI_API_KEY=your_serpapi_key_here
BING_SEARCH_API_KEY=your_bing_search_key_here

# AI/LLM Configuration
# Opțiuni: "openai", "ollama", "anthropic"
AI_MODEL_TYPE=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_TEMPERATURE=0.7

# Ollama Configuration (dacă folosești local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Anthropic Configuration
ANTHROPIC_API_KEY=your_anthropic_key_here

# Backend Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_WORKERS=4
DEBUG=false

# Security & Limits
MAX_RESULTS_PER_QUERY=3
REQUEST_TIMEOUT_SECONDS=10
PAGE_FETCH_TIMEOUT_SECONDS=8
MAX_PAGE_SIZE_MB=5
RATE_LIMIT_REQUESTS_PER_MINUTE=20
MAX_QUESTION_LENGTH=500

# CORS Configuration
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
